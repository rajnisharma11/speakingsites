# Server-side only — never expose this with NEXT_PUBLIC_ prefix.
LIVEAVATAR_API_KEY=0d6cbda0-5419-11f1-8d28-066a7fa2e369

# Fallback avatar when the request has no industry (Wayne).
LIVEAVATAR_DEFAULT_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a

# Sandbox mode = free + unlimited testing, BUT this account only allows
# the Wayne avatar in sandbox. All industries collapse to Wayne when true.
# Set to "false" to unlock per-industry avatars (consumes real credits).
LIVEAVATAR_IS_SANDBOX=true
LIVEAVATAR_MAX_SESSION_DURATION=1800

# LLM context (system prompt) — without this, the avatar parrots your text
# verbatim instead of acting like an agent. Create more via
# POST https://api.liveavatar.com/v1/contexts
LIVEAVATAR_CONTEXT_ID=e8c80653-c329-4ff8-8637-22feaa1bec9e

# SpeakingSites Laravel backend — used by the conversation proxy routes
# to persist Hero demo sessions as Leads in the admin panel.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_EMBED_API_KEY=sk_eJf059jgseEykz46rjQrGJoYDbmSRgfqldlnzae2zOZMMQ8O
